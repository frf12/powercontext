# ===== 记忆体验 Demo 配置 =====
# 进门口令（现场口头告知体验者）
DEMO_PASSPHRASE=memory2026

# 对外端口
DEMO_PORT=8080

# 聊天模型：任何 OpenAI 兼容端点（DeepSeek / Claude 兼容网关 / vLLM 均可）
DEMO_LLM_BASE_URL=https://api.deepseek.com/v1
DEMO_LLM_API_KEY=sk-replace-me
DEMO_LLM_MODEL=deepseek-chat
# 可选：合并进聊天请求体的额外 JSON（如 DashScope qwen3 系列关思考）
# DEMO_LLM_EXTRA_BODY={"enable_thinking": false}

# ===== PowerContext 自动提取（Source -> Memory）=====
# 模型格式为 <provider>:<model>；Chat Completions 兼容端点（DeepSeek / vLLM 等）用
# openai-chat: 前缀；openai: 前缀走 Responses API，只有 api.openai.com 提供
# 鉴权通过 headers 的 JSON 配置
POWERCONTEXT_SERVER_INFERENCE_GENERATION_MODEL=openai-chat:deepseek-chat
POWERCONTEXT_SERVER_INFERENCE_GENERATION_BASE_URL=https://api.deepseek.com/v1
POWERCONTEXT_SERVER_INFERENCE_GENERATION_HEADERS={"Authorization":"Bearer sk-replace-me"}
# 可选：提取模型的额外参数（如 qwen3 系列关思考，减少幻觉引用）
# POWERCONTEXT_SERVER_INFERENCE_GENERATION_MODEL_SETTINGS={"extra_body":{"enable_thinking":false}}

# ===== PowerContext 向量检索（可选；三项必须一起配置，不配则退化为关键词检索）=====
# POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_MODEL=openai:text-embedding-3-small
# POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_PROFILE_ID=openai-text-embedding-3-small-1536-unit
# POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_DIMENSION=1536
# POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_BASE_URL=https://api.openai.com/v1
# POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_HEADERS={"Authorization":"Bearer sk-replace-me"}
